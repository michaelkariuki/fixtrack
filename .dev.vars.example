# Copy to .dev.vars for local Wrangler runs. Never commit .dev.vars.
# Production values go in `wrangler secret put <NAME>`.

# Accounts and email (optional in development)
AUTH_DEV_LINKS=true
APP_URL=http://localhost:5174
RESEND_API_KEY=
EMAIL_FROM=FixTrack <onboarding@resend.dev>

# M-Pesa Daraja STK Push (optional; STK returns 503 without these)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=

# Africa's Talking SMS (optional)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
